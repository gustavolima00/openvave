{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openvave:cli:set-fields:v2",
  "title": "openvave set FIELD=VALUE ... --json (batch edit over one connection), schema_version 2",
  "description": "Printed on success, for --dry-run, and on a failure mid-batch (then result.applied is false and result.fields says which fields were applied). The FIELD VALUE form keeps write-result.schema.json; tell them apart by plan.writes.",
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "read_at",
    "device",
    "identity",
    "plan"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "command": {
      "const": "set"
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    },
    "plan": {
      "type": "object",
      "required": [
        "action",
        "fields",
        "writes",
        "reads",
        "before",
        "global_before",
        "no_change",
        "refusal",
        "refused_field",
        "dry_run"
      ],
      "properties": {
        "action": {
          "const": "set"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "field",
              "kind",
              "offset",
              "before",
              "requested",
              "no_change",
              "refusal"
            ],
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "knob_block",
                  "block_switch",
                  "led_colour"
                ]
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20
              },
              "before": {
                "$ref": "#/$defs/hex"
              },
              "requested": {
                "$ref": "#/$defs/hex",
                "description": "empty when out of range or the type cannot be resolved"
              },
              "no_change": {
                "type": "boolean"
              },
              "refusal": {
                "enum": [
                  null,
                  "out_of_range",
                  "untested_firmware",
                  "experimental_required",
                  "tuner_mode",
                  "bypassed",
                  "unrecognised_state",
                  "type_required"
                ]
              }
            }
          }
        },
        "writes": {
          "type": "array",
          "description": "in send order: the knob block (all knob fields), block switches 0-3, the LED colour",
          "items": {
            "type": "object",
            "required": [
              "target",
              "data",
              "frame",
              "fields",
              "confidence"
            ],
            "additionalProperties": false,
            "properties": {
              "target": {
                "type": "object",
                "required": [
                  "kind",
                  "type",
                  "address",
                  "length",
                  "argument"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "knob_block",
                      "block_switch",
                      "led_colour"
                    ]
                  },
                  "type": {
                    "const": 4
                  },
                  "address": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{8}$"
                  },
                  "length": {
                    "enum": [
                      1,
                      3,
                      14
                    ]
                  },
                  "argument": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              },
              "data": {
                "$ref": "#/$defs/hex"
              },
              "frame": {
                "$ref": "#/$defs/hex"
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "confidence": {
                "enum": [
                  "confirmed",
                  "observed",
                  "hypothesis"
                ]
              }
            }
          }
        },
        "reads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hex"
          }
        },
        "before": {
          "$ref": "#/$defs/hex",
          "description": "edit buffer, 21 bytes"
        },
        "global_before": {
          "$ref": "#/$defs/hex",
          "description": "global block, 4 bytes"
        },
        "no_change": {
          "type": "boolean"
        },
        "refusal": {
          "enum": [
            null,
            "out_of_range",
            "untested_firmware",
            "experimental_required",
            "tuner_mode",
            "bypassed",
            "unrecognised_state",
            "type_required"
          ]
        },
        "refused_field": {
          "type": [
            "string",
            "null"
          ],
          "description": "null for a state refusal"
        },
        "dry_run": {
          "type": "boolean"
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "writes",
        "fields",
        "after",
        "global_after",
        "changes",
        "applied"
      ],
      "properties": {
        "writes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "status",
              "reply",
              "applied"
            ],
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "acked",
                  "nak",
                  "no_reply",
                  "not_sent"
                ]
              },
              "reply": {
                "$ref": "#/$defs/hex"
              },
              "applied": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "applied",
              "unchanged",
              "not_applied",
              "unknown",
              "not_sent"
            ]
          }
        },
        "after": {
          "oneOf": [
            {
              "$ref": "#/$defs/hex"
            },
            {
              "type": "null"
            }
          ]
        },
        "global_after": {
          "oneOf": [
            {
              "$ref": "#/$defs/hex"
            },
            {
              "type": "null"
            }
          ]
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "region",
              "offset",
              "before",
              "after"
            ],
            "properties": {
              "region": {
                "enum": [
                  "global",
                  "preset"
                ]
              },
              "offset": {
                "type": "integer"
              },
              "before": {
                "type": "integer"
              },
              "after": {
                "type": "integer"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "applied": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^([0-9a-f]{2}( [0-9a-f]{2})*)?$"
    }
  }
}
